# ─── PlaceToPay Credentials ────────────────────────────────────
# SANDBOX → https://checkout-test.placetopay.com
# PRODUCCIÓN → https://checkout.placetopay.com
PLACETOPAY_LOGIN=your_login_here
PLACETOPAY_TRANKEY=your_trankey_here
PLACETOPAY_ENV=sandbox

# ─── MongoDB Atlas ─────────────────────────────────────────────
# Leave empty for local contact-only tests. Never point local tests to Atlas.
MONGODB_URI=

# ─── Server Config ─────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Contacto LOCAL: MariaDB Docker (solo desarrollo) ─────────
# Create the ignored file .env.contact.local from this template and replace
# every placeholder locally. Do not put these values in a versioned file.
# CONTACT_DB_TARGET=local
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=<local-user>
# MYSQL_PASSWORD=<local-password>
# MYSQL_DATABASE=<local-database>
# MARIADB_ROOT_PASSWORD=<local-root-password>
# MYSQL_SOCKET_PATH=
# The Compose and backend scripts require .env.contact.local to exist.

# ─── Contacto: email vía Resend (inyectar solo en .env local) ──
# Leave these placeholders empty to test persistence without sending email.
# Replace them only in the ignored .env.contact.local when a real Resend test is explicitly intended.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Production must explicitly set CONTACT_DB_TARGET=hostinger in its own secret
# environment. Never copy Hostinger settings into this local file.

# ─── Seguridad (obligatorio en producción) ─────────────────────
# Generar valores aleatorios largos (32+ caracteres) — nunca commitear los reales
ADMIN_JWT_SECRET=
PAYMENT_ACCESS_SECRET=
CRON_SECRET=

# ─── Admin bootstrap (solo desarrollo / primera instalación) ───
# ADMIN_BOOTSTRAP_PASSWORD=  # contraseña inicial si no existen usuarios
# ALLOW_ADMIN_SEED=true      # permitir seed de usuarios en producción (solo migración)
# ALLOW_ADMIN_MASTER=true    # permitir ADMIN_MASTER_PASSWORD en producción (no recomendado)

# ─── Netlify (producción) ─────────────────────────────────────
# Configurar en Netlify Dashboard > Site settings > Environment variables:
#   PLACETOPAY_LOGIN, PLACETOPAY_TRANKEY, PLACETOPAY_ENV=production
#   MONGODB_URI, ADMIN_JWT_SECRET, PAYMENT_ACCESS_SECRET, CRON_SECRET
#   FRONTEND_URL=https://laindustriabolera.co
